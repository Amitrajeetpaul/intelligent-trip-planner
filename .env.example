# Database (REQUIRED)
DATABASE_URL=postgresql://user:password@localhost:5432/trip_planner

# AI Provider (OPTIONAL - choose one or leave empty for manual mode)
# Options: "openai", "gemini", "deepseek", "groq", "none"
AI_PROVIDER=gemini

# AI API Keys (only fill in the one you're using)

# Option 1: Google Gemini (FREE - 15 requests/min, 1500/day) ⭐ RECOMMENDED
# Get key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Option 2: OpenAI (Paid - ~$0.01-0.05 per trip)
# Get key from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=your_openai_api_key_here

# Option 3: DeepSeek (Very Cheap - ~$0.14 per 1M tokens)
# Get key from: https://platform.deepseek.com/
# DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Option 4: Groq (FREE - Fast inference)
# Get key from: https://console.groq.com/keys
# GROQ_API_KEY=your_groq_api_key_here
